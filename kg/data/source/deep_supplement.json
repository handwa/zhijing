  "triples": [
    {
      "id": "tri.linear-in-dim.1",
      "claimId": "clm.arch.ffn.linear-in-dim.4a3e",
      "cardId": "crd.s1-1-linear",
      "statement": "输入张量的最后一维必须等于权重的输入维度",
      "kind": "shape",
      "mechanism": "矩阵乘要沿内维归约求和；内维不等时这个求和没有定义，运算直接失败。所以内维相等不是建议，而是运算能否存在的前提。",
      "computable": true,
      "interventions": [
        {
          "id": "inv.linear-in-x.4-to-5",
          "action": "把输入最后一维从 4 改成 5",
          "overrides": {
            "in_x": 5
          },
          "contract": {
            "symbols": {
              "N": 8,
              "in_x": 4,
              "in_w": 4,
              "out_w": 6
            },
            "op": {
              "kind": "matmul",
              "lhs": [
                "N",
                "in_x"
              ],
              "rhs": [
                "out_w",
                "in_w"
              ],
              "rhsTransposed": true
            },
            "constraints": [
              {
                "kind": "equals",
                "left": "in_x",
                "right": "in_w",
                "describe": "输入最后一维必须等于权重输入维"
              }
            ]
          },
          "consequence": "内维 5 与 4 不等，矩阵乘未定义，命题不成立",
          "source": "COMPUTED",
          "misjudgements": [
            {
              "predicted": "HOLDS",
              "why": "把内维当成结果维，以为维度不等只会让输出变宽",
              "correction": "内维是要被消掉的那一维，必须相等才能求和；它不会出现在结果里"
            }
          ]
        },
        {
          "id": "inv.linear-batch.8-to-160",
          "action": "把 batch 从 8 改成 160",
          "overrides": {
            "N": 160
          },
          "contract": {
            "symbols": {
              "N": 8,
              "in_x": 4,
              "in_w": 4,
              "out_w": 6
            },
            "op": {
              "kind": "matmul",
              "lhs": [
                "N",
                "in_x"
              ],
              "rhs": [
                "out_w",
                "in_w"
              ],
              "rhsTransposed": true
            },
            "constraints": [
              {
                "kind": "equals",
                "left": "in_x",
                "right": "in_w",
                "describe": "输入最后一维必须等于权重输入维"
              }
            ]
          },
          "consequence": "batch 是前导维，不参与内维约束，命题仍成立",
          "source": "COMPUTED",
          "misjudgements": [
            {
              "predicted": "FAILS",
              "why": "以为输入一变就会破坏形状约束",
              "correction": "约束只作用于最后一维；前导维可以任意变，这正是 batch 能自由调整的原因"
            }
          ]
        }
      ]
    },
    {
      "id": "tri.softmax-sum.1",
      "claimId": "clm.arch.ffn.softmax-sum.a505",
      "cardId": "crd.s1-3-softmax",
      "statement": "Softmax 的输出沿类别维度求和为 1",
      "kind": "statistics",
      "mechanism": "softmax 在类别维上做归一化：每个位置的指数值都除以该维总和。因此沿同一维再求和，恒等于 1。",
      "computable": true,
      "interventions": [
        {
          "id": "inv.softmax-sum.class-axis",
          "action": "沿类别维（最后一维）求和",
          "contract": {
            "symbols": {
              "N": 8,
              "C": 10
            },
            "op": {
              "kind": "softmaxSum",
              "input": [
                "N",
                "C"
              ],
              "softmaxAxis": 1,
              "sumAxis": 1
            },
            "constraints": []
          },
          "consequence": "沿归一化维求和，结果恒为 1",
          "source": "COMPUTED",
          "misjudgements": [
            {
              "predicted": "FAILS",
              "why": "把求和当成计数，以为结果会是类别数 10",
              "correction": "softmax 已经把每个位置的指数值除以了总和，所以同一维上再相加就是 1；计数是另一件事"
            }
          ]
        },
        {
          "id": "inv.softmax-sum.batch-axis",
          "action": "沿 batch 维求和",
          "contract": {
            "symbols": {
              "N": 8,
              "C": 10
            },
            "op": {
              "kind": "softmaxSum",
              "input": [
                "N",
                "C"
              ],
              "softmaxAxis": 1,
              "sumAxis": 0
            },
            "constraints": []
          },
          "consequence": "沿 batch 维求和是把不同样本的概率相加，结果不等于 1",
          "source": "COMPUTED",
          "misjudgements": [
            {
              "predicted": "HOLDS",
              "why": "以为输出是概率分布，所以怎么求和都是 1",
              "correction": "归一化只发生在 softmax 的那一根轴上；换一根轴求和，相当于把不同样本的概率加在一起"
            }
          ]
        }
      ]
    },
    {
      "id": "tri.softmax-dim.1",
      "claimId": "clm.arch.ffn.softmax-dim.4af1",
      "cardId": "crd.s1-3-softmax",
      "statement": "Softmax 归一化的是类别维，不是 batch 维",
      "kind": "statistics",
      "mechanism": "softmax 沿指定轴把每个元素除以该轴上的总和。类别维是「同一样本内部的不同类别」，沿它归一化，每个样本才得到一个概率分布；沿 batch 维归一化会让不同样本的 logits 互相竞争，样本 0 的预测取决于样本 1 的输入。",
      "computable": true,
      "interventions": [
        {
          "id": "inv.softmax-dim.class-axis",
          "action": "输入 (N=8, C=10)，softmax 沿类别维，再沿类别维求和",
          "contract": {
            "symbols": {
              "N": 8,
              "C": 10
            },
            "op": {
              "kind": "softmaxSum",
              "input": [
                "N",
                "C"
              ],
              "softmaxAxis": 1,
              "sumAxis": 1
            },
            "constraints": []
          },
          "consequence": "沿归一化轴求和恒为 1，每个样本各自是一个概率分布",
          "source": "COMPUTED",
          "misjudgements": [
            {
              "predicted": "FAILS",
              "why": "把「沿类别维求和」和「沿 batch 维求和」记混了",
              "correction": "softmax 只归一化一根轴；这里归一化的就是类别维，沿同一根轴再求和必然等于 1"
            }
          ]
        },
        {
          "id": "inv.softmax-dim.sum-batch",
          "action": "输入 (N=8, C=10)，softmax 沿类别维，改沿 batch 维求和",
          "contract": {
            "symbols": {
              "N": 8,
              "C": 10
            },
            "op": {
              "kind": "softmaxSum",
              "input": [
                "N",
                "C"
              ],
              "softmaxAxis": 1,
              "sumAxis": 0
            },
            "constraints": []
          },
          "consequence": "沿 batch 维求和等于把不同样本的同一类概率相加，结果在 0..8 之间，不是 1",
          "source": "COMPUTED",
          "misjudgements": [
            {
              "predicted": "HOLDS",
              "why": "以为「输出是概率分布」意味着往哪个方向加都是 1",
              "correction": "归一化只发生在类别轴；batch 轴上每个位置是独立样本，加起来是若干概率之和"
            }
          ]
        },
        {
          "id": "inv.softmax-dim.axis-on-batch",
          "action": "把 softmax 改成沿 batch 维归一化，再沿类别维求和",
          "contract": {
            "symbols": {
              "N": 8,
              "C": 10
            },
            "op": {
              "kind": "softmaxSum",
              "input": [
                "N",
                "C"
              ],
              "softmaxAxis": 0,
              "sumAxis": 1
            },
            "constraints": []
          },
          "consequence": "归一化跑到 batch 维之后，类别维上的和不再等于 1",
          "source": "COMPUTED",
          "misjudgements": [
            {
              "predicted": "HOLDS",
              "why": "以为「softmax 之后沿类别维求和等于 1」与轴无关",
              "correction": "求和为 1 的前提是「求和轴与归一化轴同一根」；轴换了，等式就不成立"
            }
          ]
        },
        {
          "id": "inv.softmax-dim.rank3-last",
          "action": "序列输入 (N=4, T=6, C=10)，softmax 沿最后一维，沿最后一维求和",
          "contract": {
            "symbols": {
              "N": 4,
              "T": 6,
              "C": 10
            },
            "op": {
              "kind": "softmaxSum",
              "input": [
                "N",
                "T",
                "C"
              ],
              "softmaxAxis": -1,
              "sumAxis": -1
            },
            "constraints": []
          },
          "consequence": "负轴从末尾数，-1 就是类别维；每个时间步各自归一化，和为 1",
          "source": "COMPUTED",
          "misjudgements": [
            {
              "predicted": "FAILS",
              "why": "以为维数变多之后「最后一维」就不再是类别维",
              "correction": "轴 -1 永远是从末尾数第一维；多一个时间步不改变类别维的位置"
            }
          ]
        },
        {
          "id": "inv.softmax-dim.rank3-time",
          "action": "序列输入 (N=4, T=6, C=10)，softmax 沿最后一维，改沿时间维求和",
          "contract": {
            "symbols": {
              "N": 4,
              "T": 6,
              "C": 10
            },
            "op": {
              "kind": "softmaxSum",
              "input": [
                "N",
                "T",
                "C"
              ],
              "softmaxAxis": -1,
              "sumAxis": 1
            },
            "constraints": []
          },
          "consequence": "沿时间维求和是把同一类别在不同时间步的概率相加，不等于 1",
          "source": "COMPUTED",
          "misjudgements": [
            {
              "predicted": "HOLDS",
              "why": "只记得「沿 batch 维求和才不成立」，以为时间维是另一回事",
              "correction": "只有归一化轴成立；时间维和 batch 维一样，都只是「另一根轴」"
            }
          ]
        }
      ]
    },
